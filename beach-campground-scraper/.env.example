# Copy to .env, fill in, then run ./ship.sh — never commit .env itself.
# CI decrypts .env.encrypted and turns these into the campscout-secrets
# Secret; config.yaml references them as ${VAR} so they stay out of the
# ConfigMap.

# ntfy topic to push alerts to. Pick something unguessable — anyone who
# knows the topic name can read your alerts.
NTFY_TOPIC=sd-camping-CHANGEME

# An outside service that alerts YOU when pings stop (e.g. healthchecks.io).
# Without it, a cluster that stops running scans looks exactly like a
# booked-out campground.
CAMPSCOUT_HEARTBEAT_URL=https://hc-ping.com/CHANGEME

# Only needed if you enable the email notifier in the ConfigMap.
# SMTP_USERNAME=
# SMTP_PASSWORD=
